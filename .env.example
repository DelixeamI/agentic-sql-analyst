# Copy to .env and adjust. Every variable is optional.

# Read-only role created by db/init/03_readonly_role.sql (host port 5433 -> container 5432).
DATABASE_URL=postgresql+asyncpg://analyst_ro:analyst_ro_password@localhost:5433/shop
STATEMENT_TIMEOUT_MS=5000
DEFAULT_ROW_LIMIT=100
MAX_RETRIES=3

# --- LLM ---------------------------------------------------------------------
# demo   : offline scripted LLM, no key needed (fixed set of example questions)
# openai : any OpenAI-compatible API
LLM_PROVIDER=demo

# OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# Ollama (local, free): `ollama pull qwen2.5:14b`
# LLM_PROVIDER=openai
# LLM_MODEL=qwen2.5:14b
# LLM_BASE_URL=http://localhost:11434/v1
# (inside docker compose use http://host.docker.internal:11434/v1)

# OpenRouter / vLLM / GigaChat via OpenAI-compatible proxy
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen-2.5-72b-instruct
# LLM_API_KEY=...
# LLM_JSON_MODE=false   # if the endpoint does not support response_format=json_object
